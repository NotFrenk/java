package com.spring.rubrica.utility;

import com.spring.rubrica.dto.ContattoDTO;
import com.spring.rubrica.dto.RubricaDTO;
import com.spring.rubrica.entity.ContattoEntity;
import com.spring.rubrica.entity.RubricaEntity;

public class Conversioni {
	
	public static ContattoEntity daContattoDtoAContatto(ContattoDTO dto) {
        return new ContattoEntity(dto.getIdcontatto(), dto.getNome(), dto.getCognome(), dto.getNumero());
    }
    
    public static ContattoDTO daContattoAContattoDto(ContattoEntity contatto) {
        return new ContattoDTO(contatto.getIdcontatto(), contatto.getNome(), contatto.getCognome(), contatto.getNumero());
    }
    
    public static RubricaEntity daRubricaDtoARubrica(RubricaDTO dto) {
    	RubricaEntity rubrica = new RubricaEntity(dto.getIdRubrica(), dto.getProprietario(), dto.getAnnoCreazione());
        
        // converto la lista
        List<ContattoDTO> listaD = dto.getContatti();
        
        List<Contatto> lista = listaD.stream()
                .map(contattoD -> Conversioni.daContattoDtoAContatto(contattoD))
                .collect(Collectors.toList());
        
        rubrica.setContatti(lista);
        return rubrica;
        
    }
    
    public static RubricaDTO daRubricaARubricaDto(RubricaEntity rubrica) {
        RubricaDTO rubricaD = new RubricaDTO(rubrica.getIdRubrica(), rubrica.getProprietario(), rubrica.getAnnoCreazione());
        
        // converto la lista
        List<Contatto> lista = rubrica.getContatti();
        
        List<ContattoDTO> listaD = lista.stream()
                .map(contatto -> Conversioni.daContattoAContattoDto(contatto))
                .collect(Collectors.toList());
        
        rubricaD.setContatti(listaD);
        return rubricaD;
        
    }
}
