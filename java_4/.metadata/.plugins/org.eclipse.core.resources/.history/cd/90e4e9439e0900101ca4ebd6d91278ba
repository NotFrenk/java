package com.impiegati.service;

import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.impiegati.dao.DaoImpiegato;
import com.impiegati.dto.ImpiegatoDTO;
import com.impiegati.entity.Impiegato;
import com.impiegati.utility.Conversioni;

@Service
@Transactional
public class ServiceImpiegatoImpl implements ServiceImpiegato{
	
	@Autowired
	private DaoImpiegato dao;

	@Override
	public boolean assunzione(ImpiegatoDTO dto) {
		Impiegato entity = Conversioni.FromImpiegatoDTOToImpiegato(dto);
		return dao.save(entity) != null;
	}

	@Override
	public ImpiegatoDTO trovaImpiegato(int matricola) {
		Optional<Impiegato> opt = dao.findById(matricola);
		if (opt.isPresent()) {
			Impiegato imp = opt.get();
			return Conversioni.FromImpiegatoToImpiegatoDTO(imp);
		}else {
			return null;
		}
	}
	
	
	
}

