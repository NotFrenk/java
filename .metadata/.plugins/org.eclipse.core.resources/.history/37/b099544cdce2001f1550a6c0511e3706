import java.lang.reflect.Field;

public class Esempio4Relection {

	public static void main(String[] args) throws IllegalArgumentException, IllegalAccessException {
		persona_es4 p = new persona_es4();
		try {
			Field camponome = persona_es4.class.getDeclaredField("nome");
			camponome.setAccessible(true);
			
			System.out.println("Valore campo nome = " + camponome.getByte(p));
			
			camponome.set(p, "luiggi");
			
			System.out.println("Valore campo nome nuovo | =" + camponome.getByte(p));
			
			
		} catch (NoSuchFieldException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (SecurityException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

	}

}
